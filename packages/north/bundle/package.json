{
  "name": "@deepseek-ai/dsh-north-bundle",
  "description": "North distribution layer: brand, LAN model, office preset and skills, tightened permissions, no telemetry",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/north/bundle"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./presets/office.patch.yml": "./presets/office.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "presets/office.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/office.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-north-skill-writing": "workspace:*",
    "@deepseek-ai/dsh-north-ui-brand": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*"
  }
}
