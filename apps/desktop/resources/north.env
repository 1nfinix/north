# North 模型设置：管理员修改后重启 North 生效。
# 安装后位于 %LOCALAPPDATA%\Programs\North\resources\north.env
# Windows 用户环境变量中的同名变量优先于本文件。

# vLLM / OpenAI 兼容网关地址，以 /v1 结尾
NORTH_LLM_BASE_URL=http://127.0.0.1:8000/v1
# 网关提供的模型 id（vLLM 的 --served-model-name）
NORTH_LLM_MODEL=north-default
# 模型选择器中显示的名称
NORTH_LLM_DISPLAY_NAME=模型
# 上下文长度与输出上限（token），按 vLLM 的 --max-model-len 调整
NORTH_LLM_CONTEXT_WINDOW=32768
NORTH_LLM_MAX_TOKENS=8192
# 网关要求 key 时取消注释
# NORTH_LLM_API_KEY=
