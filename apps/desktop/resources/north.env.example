# 复制为 %USERPROFILE%\.north\north.env，管理员按需修改后重启 North 生效。
# 安装目录 resources\north.env 由安装包自带，不含真实配置，升级会覆盖。
# Windows 用户环境变量中的同名变量优先于用户配置，用户配置优先于安装包配置。

# 可选：浏览器自动探测失败时，指定浏览器程序的完整路径（Windows 64 位 Chrome 示例）。
# NORTH_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 内网模型一（模型选择器中可选）：vLLM / OpenAI 兼容网关地址，以 /v1 结尾
NORTH_LLM_BASE_URL=http://192.0.2.10:8088/v1
# 网关提供的模型 id（vLLM 的 --served-model-name）
NORTH_LLM_MODEL=example-model-a
# 模型选择器中显示的名称
NORTH_LLM_DISPLAY_NAME=示例模型 A
# 上下文长度与输出上限（token），按 vLLM 的 --max-model-len 调整
NORTH_LLM_CONTEXT_WINDOW=300000
NORTH_LLM_MAX_TOKENS=65536
# 网关要求 key 时取消注释
# NORTH_LLM_API_KEY=

# 内网模型二（模型选择器中可选）：各项含义同上
NORTH_LLM2_BASE_URL=http://192.0.2.20:18800/v1
NORTH_LLM2_MODEL=example-model-b
NORTH_LLM2_DISPLAY_NAME=示例模型 B
NORTH_LLM2_CONTEXT_WINDOW=120000
NORTH_LLM2_MAX_TOKENS=65536
NORTH_LLM2_API_KEY=dummy_key

# 内网模型三（模型选择器中可选）：各项含义同上
NORTH_LLM3_BASE_URL=http://192.0.2.30:8317/v1
NORTH_LLM3_MODEL=example-model-c
NORTH_LLM3_DISPLAY_NAME=示例模型 C
NORTH_LLM3_CONTEXT_WINDOW=120000
NORTH_LLM3_MAX_TOKENS=65536
NORTH_LLM3_API_KEY=dummy_key

# 内网模型四（模型选择器中可选）：各项含义同上
NORTH_LLM4_BASE_URL=http://192.0.2.40:8080/v1
NORTH_LLM4_MODEL=example-model-d
NORTH_LLM4_DISPLAY_NAME=示例模型 D
NORTH_LLM4_CONTEXT_WINDOW=120000
NORTH_LLM4_MAX_TOKENS=65536
NORTH_LLM4_API_KEY=dummy_key

# 管理网电脑经代理访问模型：本机有以 NORTH_PROXY_NETWORK 开头的 IPv4 地址时，
# North 使用 NORTH_PROXY；生产网电脑直连。已设置 HTTP_PROXY / HTTPS_PROXY 的电脑以其为准。
NORTH_PROXY=http://198.51.100.20:8080
NORTH_PROXY_NETWORK=198.51.100.

# 能访问互联网时：填写 DeepSeek API key 后新会话默认使用 DeepSeek，模型选择器同时保留内网模型。
# 也可以在「设置 → 模型」页保存 key，或设置同名的系统环境变量。
# DEEPSEEK_API_KEY=
# NORTH_DEEPSEEK_MODEL=deepseek-v4-pro

# 按人发送网关要求的请求头；头名按网关约定修改。
# NORTH_USER_ID=<每人自己的工号，建议设为 Windows 用户环境变量>
# NORTH_MAC_ID=<不填则按 NORTH_MAC_NETWORK 自动识别>
NORTH_MAC_NETWORK=192.0.2.
# NORTH_LLM_HEADERS={"X-User-Id":"${NORTH_USER_ID}","X-Mac-Id":"${NORTH_MAC_ID}"}
# NORTH_LLM2_HEADERS={"X-User-Id":"${NORTH_USER_ID}","X-Mac-Id":"${NORTH_MAC_ID}"}
# NORTH_LLM3_HEADERS={"X-User-Id":"${NORTH_USER_ID}","X-Mac-Id":"${NORTH_MAC_ID}"}
# NORTH_LLM4_HEADERS={"X-User-Id":"${NORTH_USER_ID}","X-Mac-Id":"${NORTH_MAC_ID}"}
